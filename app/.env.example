# Configuración de la aplicación de ventas (app/docker-compose.yml)
# Copiar este archivo como `app/.env` antes de levantar la app o ejecutar `npm run deploy-app`.

# Imagen Confluent usada solo por init-topics (kafka-topics); debe coincidir con la de los brokers
CONFLUENT_VERSION=7.5.3

# Brokers Kafka:
# - En AWS (EC2): IPs privadas anunciadas por app-zookeper y app-broker-0 (VPC 10.10.0.0/22)
# - En desarrollo local (si corres fuera de contenedores): localhost:9092,localhost:9093
KAFKA_BOOTSTRAP=10.10.0.10:9092,10.10.2.10:9092

# Topics: entrada (ventas crudas), salida (agregado por tienda y ventana) y DLQ (eventos inválidos/duplicados)
RAW_TOPIC=ventas-raw
AGG_TOPIC=ventas-agregadas
DLQ_TOPIC=ventas-raw-dlq

# Particiones por topic y replicación común al crearlos (2 brokers -> RF máximo 2)
RAW_PARTITIONS=4
AGG_PARTITIONS=2
DLQ_PARTITIONS=4
TOPIC_REPLICATION_FACTOR=2

# Kafka Streams: application.id (nombra el consumer group y los topics internos)
GROUP_ID=ventas-aggregator-v2
# Ventana tumbling por eventTime en segundos; se emite recién al cerrarse (fin + gracia)
WINDOW_SECONDS=60
# Gracia: eventos fuera de orden hasta este plazo aún se suman a su ventana; después se descartan
WINDOW_GRACE_SECONDS=30
# Cuánto tiempo se recuerdan los eventId para detectar duplicados
DEDUP_RETENTION_SECONDS=3600
# eventTime más allá de ahora + este margen es inválido (evita adelantar el stream time)
MAX_FUTURE_SKEW_SECONDS=300

# Productor de ventas simuladas
PRODUCE_INTERVAL=1.0
# Probabilidad (0-1) de que el productor emita un evento inválido hacia la DLQ; 0 = nunca
INVALID_RATE=0.1
# 0 = infinito (con un límite, la última ventana no se cierra ni se emite sin eventos posteriores)
PRODUCER_MAX_EVENTS=0
CUSTOMER_POOL=200
