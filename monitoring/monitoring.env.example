GRAFANA_ADMIN_PASSWORD=replace-with-a-long-random-password
# Dominio por el que nginx publica Grafana (scripts/configure-nginx.js)
GRAFANA_DOMAIN=grafana.ejemplo.com
# IP fija de app-monitoring (terraform/main.tf, private_ips); Loki hace bind a esta IP
MONITORING_PRIVATE_IP=10.10.0.20

# IPs privadas fijas de los targets (terraform/main.tf, private_ips); no uses IPs publicas.
# Kafka 1 y ZooKeeper comparten host (app-zookeper).
KAFKA_1_PRIVATE_IP=10.10.0.10
KAFKA_2_PRIVATE_IP=10.10.2.10
ZOOKEEPER_PRIVATE_IP=10.10.0.10
APP_PRIVATE_IP=10.10.3.10
