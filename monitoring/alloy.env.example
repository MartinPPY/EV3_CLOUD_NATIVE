# NODE_NAME identifica el nodo en los logs (label "node"): zookeper, broker-0, app o monitoring.
# scripts/deploy-monitoring.js lo fija por nodo al desplegar; aquí es solo la referencia.
NODE_NAME=zookeper
# Loki en app-monitoring (IP fija, puerto 3100 abierto en sg-monitoring para sg-kafka y sg-app)
LOKI_URL=http://10.10.0.20:3100/loki/api/v1/push
