# Variables de entorno y secretos (se permiten explícitamente las plantillas *.example)
.env
**/.env
.env.*
**/.env.*
*.env
**/*.env
!.env.example
!**/.env.example
!*.env.example
!**/*.env.example

# Certificados y llaves privadas
*.pem
*.key
*.crt
*.p12

# Terraform (se mantiene .terraform.lock.hcl para fijar versiones de providers)
**/.terraform/
*.tfstate
*.tfstate.*
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
!**/*.tfvars.example
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc

# Java / Maven (app/)
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*

# Node.js (scripts/)
**/node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Sistema operativo, editores y temporales
.DS_Store
Thumbs.db
desktop.ini
.idea/
*.iml
.vscode/
*.swp
*~
*.log

evidencia/