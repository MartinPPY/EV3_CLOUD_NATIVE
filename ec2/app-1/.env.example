# Configuración de EC2 app-zookeper (ec2/app-1/docker-compose.yml): ZooKeeper + Broker 1 + Kafka UI
# Copiar este archivo como `ec2/app-1/.env` y cambiar KAFKA_UI_PASSWORD antes de ejecutar `npm run deploy-kafka`.

# Versión de las imágenes Confluent (zookeeper y kafka deben coincidir)
CONFLUENT_VERSION=7.5.3

# Perfiles de compose activos: "zk" levanta el ZooKeeper junto al broker (quitarlo si corre en otro host)
COMPOSE_PROFILES=zk

# Red (IPs privadas fijas de la VPC definida en terraform/main.tf)
PRIVATE_IP=10.10.0.10
ZOOKEEPER_IP=10.10.0.10
# Broker 2 (app-broker-0), para el bootstrap de Kafka UI
BROKER_2_IP=10.10.2.10

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka broker 1
KAFKA_BROKER_ID=1
KAFKA_PORT=9092

# Configuración común de Kafka (2 brokers -> replicación máxima de 2)
KAFKA_DEFAULT_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_NUM_PARTITIONS=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true

# Kafka UI (nginx la sirve por https://kafka.ejemplo.com; el puerto debe coincidir con scripts/configure-nginx.js)
KAFKA_UI_VERSION=v0.7.2
KAFKA_UI_PORT=8080
KAFKA_UI_CLUSTER_NAME=act3
# Expuesta a internet: reemplazar por una contraseña robusta antes de desplegar
KAFKA_UI_USER=admin
KAFKA_UI_PASSWORD=reemplazar-con-clave-segura
