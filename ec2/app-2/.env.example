# Configuración de EC2 app-broker-0 (ec2/app-2/docker-compose.yml): Broker 2
# Copiar este archivo como `ec2/app-2/.env` antes de ejecutar `npm run deploy-kafka`.

# Versión de las imágenes Confluent (debe coincidir con la de ec2/app-1)
CONFLUENT_VERSION=7.5.3

# Red (app-broker-0: broker 2; el ZooKeeper está en app-zookeper)
PRIVATE_IP=10.10.2.10
ZOOKEEPER_IP=10.10.0.10
ZOOKEEPER_CLIENT_PORT=2181

# Kafka broker 2
KAFKA_BROKER_ID=2
KAFKA_PORT=9092

# Configuración común de Kafka (2 brokers -> replicación máxima de 2)
KAFKA_DEFAULT_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_NUM_PARTITIONS=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
