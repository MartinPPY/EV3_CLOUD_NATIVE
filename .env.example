# Configuración del clúster Kafka local (docker-compose.yml en la raíz)
# Copiar este archivo como `.env` antes de ejecutar `docker compose up -d`.

# Versión de las imágenes Confluent (zookeeper y kafka deben coincidir)
CONFLUENT_VERSION=7.5.3

# Zookeeper
ZOOKEEPER_CLIENT_PORT=2181
ZOOKEEPER_TICK_TIME=2000

# Kafka broker 1
KAFKA_BROKER_1_ID=1
KAFKA_BROKER_1_INTERNAL_PORT=29092
KAFKA_BROKER_1_EXTERNAL_PORT=9092

# Kafka broker 2
KAFKA_BROKER_2_ID=2
KAFKA_BROKER_2_INTERNAL_PORT=29093
KAFKA_BROKER_2_EXTERNAL_PORT=9093

# Configuración común de Kafka (2 brokers -> replicación máxima de 2)
KAFKA_DEFAULT_REPLICATION_FACTOR=2
KAFKA_MIN_INSYNC_REPLICAS=1
KAFKA_NUM_PARTITIONS=3
KAFKA_AUTO_CREATE_TOPICS_ENABLE=true
