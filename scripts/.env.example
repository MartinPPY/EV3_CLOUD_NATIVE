# Configuración de los scripts de despliegue en scripts/ (deploy-kafka.js, deploy-app.js,
# deploy-monitoring.js y configure-nginx.js). Las variables ya definidas en la shell tienen prioridad.
# Copiar este archivo como `scripts/.env` y completar con tus valores reales (NO subir a Git).

# --- Bucket S3 de staging (obligatorio para deploy-kafka, deploy-app y deploy-monitoring) ---
# Debe existir y ser privado (los .env que suben temporalmente contienen credenciales; los scripts limpian al terminar)
S3_BUCKET=mi-bucket-despliegue-ejemplo

# --- Región AWS ---
AWS_REGION=us-east-1

# --- Credenciales AWS (ej. AWS Academy Learner Lab; caducan con cada sesión) ---
# Recomendación: exportarlas en la shell en vez de guardarlas en disco
AWS_ACCESS_KEY_ID=ASIAEXAMPLE000000000
AWS_SECRET_ACCESS_KEY=ejemploSecretAccessKeyReemplazarPorValorReal0000
AWS_SESSION_TOKEN=ejemploSessionTokenReemplazarPorTokenDeSesionDelLab

# --- deploy-kafka.js (valores opcionales; por defecto coinciden con Terraform) ---
# ZOOKEEPER_INSTANCE_NAME=act3-app-zookeper
# BROKER_INSTANCE_NAME=act3-app-broker-0
# REMOTE_DIR=/opt/kafka

# --- deploy-app.js (valores opcionales; por defecto coinciden con Terraform) ---
# APP_INSTANCE_NAME=act3-app
# APP_REMOTE_DIR=/opt/ventas

# --- deploy-monitoring.js (valores opcionales; por defecto coinciden con Terraform) ---
MONITORING_INSTANCE_NAME=act3-app-monitoring
MONITORING_REMOTE_DIR=/opt/monitoring
ALLOY_REMOTE_DIR=/opt/alloy
# LOKI_URL=http://10.10.0.20:3100/loki/api/v1/push

# --- configure-nginx.js (reverse proxy HTTPS con Let's Encrypt) ---
# Correo para avisos de Let's Encrypt (obligatorio)
CERTBOT_EMAIL=admin@ejemplo.com

# Dominio público de Kafka UI; su registro DNS A debe apuntar a la EIP eip-cloud-native
KAFKA_DOMAIN=kafka.ejemplo.com
# Puerto de Kafka UI en la EC2 (debe coincidir con KAFKA_UI_PORT en ec2/app-1/.env)
KAFKA_UI_PORT=8080
# Nombre (tag Name) de la instancia de ZooKeeper/Kafka UI
INSTANCE_NAME=act3-app-zookeper
# Opcional: fija el ID de la instancia y omite la búsqueda por nombre
# INSTANCE_ID=i-0123456789abcdef0

# Dominio público de Grafana; su registro DNS A debe apuntar a la EIP eip-grafana
GRAFANA_DOMAIN=grafana.ejemplo.com
